---
import { primaryNav } from "../../data/navigation";
import { urls } from "../../lib/urls";
import BrandLogo from "../ui/BrandLogo.astro";
---
<header class="site-header">
  <div class="container site-header__bar">
    <a href="/" class="site-header__brand" aria-label="Vyfoo home"><BrandLogo /></a>

    <nav class="primary-nav" aria-label="Primary">
      <ul class="primary-nav__list">
        {primaryNav.map((group) => (
          <li class="primary-nav__item">
            {group.columns.length === 1 && group.columns[0].links.length <= 1 ? (
              <a href={group.href}>{group.label}</a>
            ) : (
              <>
                <button class="primary-nav__trigger" aria-expanded="false" aria-haspopup="true">
                  {group.label}
                  <svg width="10" height="6" viewBox="0 0 10 6" aria-hidden="true"><path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </button>
                <div class="mega-menu">
                  <div class="mega-menu__grid">
                    {group.columns.map((col) => (
                      <div class="mega-menu__col">
                        {col.heading && <p class="mega-menu__heading">{col.heading}</p>}
                        <ul>
                          {col.links.map((link) => (
                            <li><a href={link.href}>{link.label}</a></li>
                          ))}
                        </ul>
                      </div>
                    ))}
                  </div>
                </div>
              </>
            )}
          </li>
        ))}
      </ul>
    </nav>

    <div class="site-header__actions">
      <a class="btn btn--ghost" href={urls.startTrial}>Start Free Trial</a>
      <a class="btn btn--primary" href={urls.bookDemo}>Book Enterprise Demo</a>
    </div>

    <button class="mobile-trigger" aria-expanded="false" aria-controls="mobile-nav" aria-label="Open menu">
      <span></span><span></span><span></span>
    </button>
  </div>

  <div id="mobile-nav" class="mobile-nav" hidden>
    <div class="mobile-nav__actions cta-group">
      <a class="btn btn--primary" href={urls.bookDemo}>Book Enterprise Demo</a>
      <a class="btn btn--ghost" href={urls.startTrial}>Start Free Trial</a>
    </div>
    {primaryNav.map((group) => (
      <details class="mobile-nav__group">
        <summary>{group.label}</summary>
        {group.columns.map((col) => (
          <div>
            {col.heading && <p class="mega-menu__heading">{col.heading}</p>}
            <ul>
              {col.links.map((link) => (
                <li><a href={link.href}>{link.label}</a></li>
              ))}
            </ul>
          </div>
        ))}
      </details>
    ))}
  </div>
</header>

<style>
  .site-header {
    position: sticky; top: 0; z-index: 100;
    background: rgba(255, 255, 255, 0.88);
    -webkit-backdrop-filter: blur(16px); backdrop-filter: blur(16px);
    border-bottom: 1px solid #e2e8f0;
  }
  .site-header__bar { display: flex; align-items: center; gap: 2rem; height: var(--nav-height); }
  .site-header__brand { text-decoration: none; margin-right: auto; display: inline-flex; }

  .primary-nav { display: none; }
  .primary-nav__list { display: flex; list-style: none; margin: 0; padding: 0; gap: 1.75rem; height: 100%; align-items: center; }
  .primary-nav__item { position: relative; height: 100%; display: flex; align-items: center; }
  .primary-nav__item > a, .primary-nav__trigger {
    display: flex; align-items: center; gap: 6px; padding: 8px 0;
    background: none; border: none; cursor: pointer; text-decoration: none;
    font-family: var(--font-body); font-size: 0.93rem; font-weight: 500; color: var(--color-text-primary);
    transition: color 0.15s ease;
  }
  .primary-nav__item > a:hover, .primary-nav__trigger:hover { color: var(--color-brand); }
  .primary-nav__trigger svg { color: var(--color-text-tertiary); transition: transform 0.18s ease; }
  .primary-nav__item:hover .primary-nav__trigger svg,
  .primary-nav__trigger[aria-expanded="true"] svg { transform: rotate(180deg); }

  .mega-menu {
    display: none; position: absolute; top: 100%; left: -1.5rem;
    min-width: 460px; padding: var(--space-6);
    background: #fff; border: 1px solid var(--color-border); border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
  }
  /* invisible bridge so the menu doesn't close while the pointer crosses the gap */
  .mega-menu::before { content: ""; position: absolute; left: 0; right: 0; top: -14px; height: 14px; }
  .primary-nav__item:hover .mega-menu,
  .primary-nav__item:focus-within .mega-menu,
  .mega-menu.is-open { display: block; margin-top: 6px; }
  .mega-menu__grid { display: flex; gap: var(--space-8); }
  .mega-menu__heading {
    margin: 0 0 var(--space-3); max-width: none;
    font-family: var(--font-mono); font-size: 0.68rem; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase;
    color: var(--color-text-tertiary);
  }
  .mega-menu__col ul { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 2px; white-space: nowrap; }
  .mega-menu__col a { display: block; padding: 7px 10px; margin-inline: -10px; border-radius: 8px; text-decoration: none; font-size: 0.92rem; color: var(--color-text-primary); transition: background-color 0.15s ease, color 0.15s ease; }
  .mega-menu__col a:hover { background: #f1f5f9; color: var(--color-brand); }

  .site-header__actions { display: none; gap: 0.75rem; align-items: center; }

  .mobile-trigger {
    position: relative; width: 42px; height: 42px; padding: 0; flex-shrink: 0;
    border: 1px solid #e2e8f0; border-radius: 10px; background: #fff; cursor: pointer;
  }
  .mobile-trigger span {
    position: absolute; left: 11px; right: 11px; height: 2px; border-radius: 2px; background: var(--color-obsidian);
    transition: transform 0.22s ease, opacity 0.18s ease, top 0.22s ease;
  }
  .mobile-trigger span:nth-child(1) { top: 14px; }
  .mobile-trigger span:nth-child(2) { top: 20px; }
  .mobile-trigger span:nth-child(3) { top: 26px; }
  .mobile-trigger[aria-expanded="true"] span:nth-child(1) { top: 20px; transform: rotate(45deg); }
  .mobile-trigger[aria-expanded="true"] span:nth-child(2) { opacity: 0; }
  .mobile-trigger[aria-expanded="true"] span:nth-child(3) { top: 20px; transform: rotate(-45deg); }

  .mobile-nav {
    position: absolute; left: 0; right: 0; top: 100%;
    max-height: calc(100dvh - var(--nav-height)); overflow-y: auto;
    padding: var(--space-5) var(--gutter) var(--space-8);
    background: #fff; border-bottom: 1px solid var(--color-border); box-shadow: var(--shadow-lg);
  }
  .mobile-nav__actions { margin-bottom: var(--space-4); }
  .mobile-nav__group { border-top: 1px solid var(--color-border); }
  .mobile-nav__group summary {
    padding: var(--space-4) 0; cursor: pointer; list-style: none;
    font-family: var(--font-display); font-weight: 700; font-size: 1.05rem; color: var(--color-text-primary);
    display: flex; justify-content: space-between; align-items: center;
  }
  .mobile-nav__group summary::-webkit-details-marker { display: none; }
  .mobile-nav__group summary::after {
    content: ""; width: 10px; height: 10px; border-right: 2px solid var(--color-text-tertiary); border-bottom: 2px solid var(--color-text-tertiary);
    transform: rotate(45deg) translateY(-2px); transition: transform 0.18s ease;
  }
  .mobile-nav__group[open] summary::after { transform: rotate(225deg); }
  .mobile-nav__group ul { list-style: none; padding: 0 0 var(--space-4); margin: 0; display: flex; flex-direction: column; }
  .mobile-nav__group a { display: block; padding: 11px 0; text-decoration: none; color: var(--color-text-secondary); }

  @media (min-width: 1200px) {
    .primary-nav { display: block; }
    .site-header__actions { display: flex; }
    .mobile-trigger { display: none; }
    .mobile-nav { display: none !important; }
  }
</style>

<script>
  const menuBtn = document.querySelector<HTMLButtonElement>(".mobile-trigger");
  const menuPanel = document.getElementById("mobile-nav");

  function setMenu(open: boolean) {
    if (!menuBtn || !menuPanel) return;
    menuBtn.setAttribute("aria-expanded", String(open));
    menuBtn.setAttribute("aria-label", open ? "Close menu" : "Open menu");
    menuPanel.hidden = !open;
    document.body.classList.toggle("nav-open", open);
  }
  menuBtn?.addEventListener("click", () => setMenu(menuBtn.getAttribute("aria-expanded") !== "true"));
  menuPanel?.addEventListener("click", (e) => {
    if ((e.target as HTMLElement).closest("a")) setMenu(false);
  });
  document.addEventListener("click", (e) => {
    if (e.target === document.body && document.body.classList.contains("nav-open")) setMenu(false);
  });
  window.matchMedia("(min-width: 1200px)").addEventListener("change", (e) => { if (e.matches) setMenu(false); });

  // Desktop dropdowns: click toggles (touch-safe); hover/focus handled in CSS.
  const triggers = document.querySelectorAll<HTMLButtonElement>(".primary-nav__trigger");
  function closeMenus() {
    triggers.forEach((t) => {
      t.setAttribute("aria-expanded", "false");
      t.nextElementSibling?.classList.remove("is-open");
    });
  }
  triggers.forEach((trigger) => {
    const menu = trigger.nextElementSibling as HTMLElement | null;
    trigger.addEventListener("click", () => {
      const wasOpen = menu?.classList.contains("is-open");
      closeMenus();
      if (!wasOpen) {
        trigger.setAttribute("aria-expanded", "true");
        menu?.classList.add("is-open");
      }
    });
  });
  document.addEventListener("click", (e) => {
    if (!(e.target as HTMLElement).closest(".primary-nav__item")) closeMenus();
  });
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") { closeMenus(); setMenu(false); }
  });
</script>
