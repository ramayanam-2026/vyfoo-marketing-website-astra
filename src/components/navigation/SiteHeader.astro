---
import { primaryNav } from "../../data/navigation";
import { urls } from "../../lib/urls";
---
<header class="site-header">
  <div class="container site-header__bar">
    <a href="/" class="wordmark" aria-label="Vyfoo home">Vyfoo</a>

    <nav class="primary-nav" aria-label="Primary">
      <ul class="primary-nav__list">
        {primaryNav.map((group) => (
          <li class="primary-nav__item">
            {group.columns.length === 1 && group.columns[0].links.length <= 1 ? (
              <a href={group.href}>{group.label}</a>
            ) : (
              <>
                <button class="primary-nav__trigger" aria-expanded="false" aria-haspopup="true">
                  {group.label}
                  <svg width="10" height="6" viewBox="0 0 10 6" aria-hidden="true"><path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.5" fill="none"/></svg>
                </button>
                <div class="mega-menu">
                  <div class="mega-menu__grid">
                    {group.columns.map((col) => (
                      <div class="mega-menu__col">
                        {col.heading && <p class="mega-menu__heading">{col.heading}</p>}
                        <ul>
                          {col.links.map((link) => (
                            <li><a href={link.href}>{link.label}</a></li>
                          ))}
                        </ul>
                      </div>
                    ))}
                  </div>
                </div>
              </>
            )}
          </li>
        ))}
      </ul>
    </nav>

    <div class="site-header__actions">
      <a class="btn btn--ghost" href={urls.startTrial}>Start Free Trial</a>
      <a class="btn btn--primary" href={urls.bookDemo}>Book Enterprise Demo</a>
    </div>

    <button class="mobile-trigger" aria-expanded="false" aria-controls="mobile-nav" aria-label="Open menu">
      <svg width="22" height="16" viewBox="0 0 22 16" aria-hidden="true"><path d="M0 1h22M0 8h22M0 15h22" stroke="currentColor" stroke-width="2"/></svg>
    </button>
  </div>

  <div id="mobile-nav" class="mobile-nav" hidden>
    <div class="mobile-nav__actions">
      <a class="btn btn--primary btn--block" href={urls.bookDemo}>Book Enterprise Demo</a>
      <a class="btn btn--ghost btn--block" href={urls.startTrial}>Start Free Trial</a>
    </div>
    {primaryNav.map((group) => (
      <details class="mobile-nav__group">
        <summary>{group.label}</summary>
        {group.columns.map((col) => (
          <div>
            {col.heading && <p class="mega-menu__heading">{col.heading}</p>}
            <ul>
              {col.links.map((link) => (
                <li><a href={link.href}>{link.label}</a></li>
              ))}
            </ul>
          </div>
        ))}
      </details>
    ))}
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--color-paper);
    border-bottom: 1px solid var(--color-line);
  }
  .site-header__bar {
    display: flex;
    align-items: center;
    gap: var(--space-6);
    padding-block: var(--space-3);
  }
  .wordmark {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.35rem;
    color: var(--color-ink);
    text-decoration: none;
    margin-right: auto;
  }
  .primary-nav { display: none; }
  .primary-nav__list { display: flex; list-style: none; margin: 0; padding: 0; gap: var(--space-6); }
  .primary-nav__item { position: relative; }
  .primary-nav__item > a, .primary-nav__trigger {
    display: flex; align-items: center; gap: var(--space-1);
    background: none; border: none; font: inherit; font-size: 0.95rem; font-weight: 500;
    color: var(--color-text); text-decoration: none; cursor: pointer; padding: var(--space-2) 0;
  }
  .mega-menu {
    display: none;
    position: absolute; top: 100%; left: 50%; transform: translateX(-50%);
    background: var(--color-paper); border: 1px solid var(--color-line); border-radius: var(--radius-md);
    box-shadow: var(--shadow-lg); padding: var(--space-6); min-width: 420px; margin-top: var(--space-2);
  }
  .primary-nav__item:hover .mega-menu,
  .primary-nav__item:focus-within .mega-menu { display: block; }
  .mega-menu__grid { display: flex; gap: var(--space-8); }
  .mega-menu__heading {
    font-family: var(--font-mono); font-size: 0.7rem; letter-spacing: 0.06em; text-transform: uppercase;
    color: var(--color-text-muted); margin-bottom: var(--space-2);
  }
  .mega-menu__col ul { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: var(--space-2); white-space: nowrap; }
  .mega-menu__col a { text-decoration: none; color: var(--color-text); font-size: 0.92rem; }
  .mega-menu__col a:hover { color: var(--color-accent); }

  .site-header__actions { display: none; gap: var(--space-3); align-items: center; }

  .mobile-trigger {
    background: none; border: 1px solid var(--color-line); border-radius: var(--radius-sm);
    padding: var(--space-2) var(--space-3); color: var(--color-ink); cursor: pointer;
  }

  .mobile-nav { border-top: 1px solid var(--color-line); padding: var(--space-4) var(--space-6); background: var(--color-paper); }
  .mobile-nav__actions { display: flex; flex-direction: column; gap: var(--space-3); margin-bottom: var(--space-4); }
  .mobile-nav__group summary { padding: var(--space-3) 0; font-weight: 600; cursor: pointer; }
  .mobile-nav__group ul { list-style: none; padding: 0 0 var(--space-3); margin: 0; display: flex; flex-direction: column; gap: var(--space-2); }
  .mobile-nav__group a { text-decoration: none; color: var(--color-text-muted); }

  @media (min-width: 960px) {
    .primary-nav { display: block; }
    .site-header__actions { display: flex; }
    .mobile-trigger { display: none; }
    .mobile-nav { display: none !important; }
  }
</style>

<script>
  const trigger = document.querySelector<HTMLButtonElement>(".mobile-trigger");
  const nav = document.getElementById("mobile-nav");
  trigger?.addEventListener("click", () => {
    const expanded = trigger.getAttribute("aria-expanded") === "true";
    trigger.setAttribute("aria-expanded", String(!expanded));
    if (nav) nav.hidden = expanded;
  });
</script>
