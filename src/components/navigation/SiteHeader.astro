---
import { primaryNav } from "../../data/navigation";
import { urls } from "../../lib/urls";
---
<header class="site-header">
  <div class="container site-header__bar">
    <a href="/" class="wordmark" aria-label="Vyfoo home">
      <span class="wordmark__mark" aria-hidden="true">V</span>
      Vyfoo
    </a>

    <nav class="primary-nav" aria-label="Primary">
      <ul class="primary-nav__list">
        {primaryNav.map((group) => (
          <li class="primary-nav__item">
            {group.columns.length === 1 && group.columns[0].links.length <= 1 ? (
              <a href={group.href}>{group.label}</a>
            ) : (
              <>
                <button class="primary-nav__trigger" aria-expanded="false" aria-haspopup="true">
                  {group.label}
                  <svg width="10" height="6" viewBox="0 0 10 6" aria-hidden="true"><path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.5" fill="none"/></svg>
                </button>
                <div class="mega-menu">
                  <div class="mega-menu__grid">
                    {group.columns.map((col) => (
                      <div class="mega-menu__col">
                        {col.heading && <p class="mega-menu__heading">{col.heading}</p>}
                        <ul>
                          {col.links.map((link) => (
                            <li><a href={link.href}>{link.label}</a></li>
                          ))}
                        </ul>
                      </div>
                    ))}
                  </div>
                </div>
              </>
            )}
          </li>
        ))}
      </ul>
    </nav>

    <div class="site-header__actions">
      <a class="btn btn--ghost" href={urls.startTrial}>Start Free Trial</a>
      <a class="btn btn--primary" href={urls.bookDemo}>Book Enterprise Demo</a>
    </div>

    <button class="mobile-trigger" aria-expanded="false" aria-controls="mobile-nav" aria-label="Open menu">
      <svg width="22" height="16" viewBox="0 0 22 16" aria-hidden="true"><path d="M0 1h22M0 8h22M0 15h22" stroke="currentColor" stroke-width="2"/></svg>
    </button>
  </div>

  <div id="mobile-nav" class="mobile-nav" hidden>
    <div class="mobile-nav__actions">
      <a class="btn btn--primary btn--block" href={urls.bookDemo}>Book Enterprise Demo</a>
      <a class="btn btn--ghost btn--block" href={urls.startTrial}>Start Free Trial</a>
    </div>
    {primaryNav.map((group) => (
      <details class="mobile-nav__group">
        <summary>{group.label}</summary>
        {group.columns.map((col) => (
          <div>
            {col.heading && <p class="mega-menu__heading">{col.heading}</p>}
            <ul>
              {col.links.map((link) => (
                <li><a href={link.href}>{link.label}</a></li>
              ))}
            </ul>
          </div>
        ))}
      </details>
    ))}
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(252, 250, 248, 0.92);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--color-border);
  }
  .site-header__bar {
    display: flex;
    align-items: center;
    gap: var(--space-8);
    height: var(--nav-height);
  }
  .wordmark {
    display: inline-flex; align-items: center; gap: var(--space-2);
    font-family: var(--font-display); font-weight: 600; font-size: 1.3rem;
    color: var(--color-text-primary); text-decoration: none; margin-right: auto;
  }
  .wordmark__mark {
    display: inline-flex; align-items: center; justify-content: center;
    width: 30px; height: 30px; border-radius: 9px; background: var(--color-brand);
    color: #fff; font-size: 1rem; font-weight: 700;
  }
  .primary-nav { display: none; }
  .primary-nav__list { display: flex; list-style: none; margin: 0; padding: 0; gap: var(--space-6); height: 100%; align-items: center; }
  .primary-nav__item { position: relative; height: 100%; display: flex; align-items: center; }
  .primary-nav__item > a, .primary-nav__trigger {
    display: flex; align-items: center; gap: var(--space-1);
    background: none; border: none; font: inherit; font-size: 0.92rem; font-weight: 500;
    color: var(--color-text-primary); text-decoration: none; cursor: pointer; padding: var(--space-2) 0;
  }
  .primary-nav__trigger svg { transition: transform 0.15s ease; color: var(--color-text-secondary); }
  .primary-nav__item:hover .primary-nav__trigger svg,
  .primary-nav__trigger[aria-expanded="true"] svg { transform: rotate(180deg); }

  .mega-menu {
    display: none;
    position: absolute; top: 100%; left: 50%; transform: translateX(-50%);
    background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-md);
    box-shadow: var(--shadow-lg); padding: var(--space-6); min-width: 440px; margin-top: var(--space-3);
  }
  .primary-nav__item:hover .mega-menu,
  .primary-nav__item:focus-within .mega-menu,
  .mega-menu.is-open { display: block; }
  .mega-menu__grid { display: flex; gap: var(--space-8); }
  .mega-menu__heading {
    font-family: var(--font-mono); font-size: 0.68rem; letter-spacing: 0.06em; text-transform: uppercase;
    color: var(--color-text-secondary); margin-bottom: var(--space-2);
  }
  .mega-menu__col ul { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: var(--space-2); white-space: nowrap; }
  .mega-menu__col a { text-decoration: none; color: var(--color-text-primary); font-size: 0.9rem; }
  .mega-menu__col a:hover { color: var(--color-brand); }

  .site-header__actions { display: none; gap: var(--space-3); align-items: center; }

  .mobile-trigger {
    background: none; border: 1px solid var(--color-border-strong); border-radius: var(--radius-sm);
    padding: var(--space-2) var(--space-3); color: var(--color-text-primary); cursor: pointer;
  }

  .mobile-nav { border-top: 1px solid var(--color-border); padding: var(--space-4) var(--space-6) var(--space-8); background: var(--color-surface); max-height: calc(100dvh - var(--nav-height)); overflow-y: auto; }
  .mobile-nav__actions { display: flex; flex-direction: column; gap: var(--space-3); margin-bottom: var(--space-4); }
  .mobile-nav__group summary { padding: var(--space-3) 0; font-weight: 600; cursor: pointer; }
  .mobile-nav__group ul { list-style: none; padding: 0 0 var(--space-3); margin: 0; display: flex; flex-direction: column; gap: var(--space-2); }
  .mobile-nav__group a { text-decoration: none; color: var(--color-text-secondary); display: block; padding-block: var(--space-1); }

  @media (min-width: 960px) {
    .primary-nav { display: block; }
    .site-header__actions { display: flex; }
    .mobile-trigger { display: none; }
    .mobile-nav { display: none !important; }
  }
</style>

<script>
  const mobileTrigger = document.querySelector<HTMLButtonElement>(".mobile-trigger");
  const mobileNav = document.getElementById("mobile-nav");
  mobileTrigger?.addEventListener("click", () => {
    const expanded = mobileTrigger.getAttribute("aria-expanded") === "true";
    mobileTrigger.setAttribute("aria-expanded", String(!expanded));
    if (mobileNav) mobileNav.hidden = expanded;
  });

  // Click-to-toggle dropdowns, so the mega menu works on touch devices too
  // (not hover-only), while still supporting hover and keyboard via CSS.
  const triggers = document.querySelectorAll<HTMLButtonElement>(".primary-nav__trigger");
  triggers.forEach((trigger) => {
    const menu = trigger.nextElementSibling as HTMLElement | null;
    trigger.addEventListener("click", () => {
      const isOpen = menu?.classList.contains("is-open");
      triggers.forEach((t) => {
        t.setAttribute("aria-expanded", "false");
        t.nextElementSibling?.classList.remove("is-open");
      });
      if (!isOpen) {
        trigger.setAttribute("aria-expanded", "true");
        menu?.classList.add("is-open");
      }
    });
  });
  document.addEventListener("click", (e) => {
    if (!(e.target as HTMLElement).closest(".primary-nav__item")) {
      triggers.forEach((t) => {
        t.setAttribute("aria-expanded", "false");
        t.nextElementSibling?.classList.remove("is-open");
      });
    }
  });
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") {
      triggers.forEach((t) => {
        t.setAttribute("aria-expanded", "false");
        t.nextElementSibling?.classList.remove("is-open");
      });
    }
  });
</script>
