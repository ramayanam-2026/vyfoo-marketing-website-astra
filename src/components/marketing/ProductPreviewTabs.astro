---
interface PreviewRow { name: string; meta: string; status?: string; }
interface PreviewTab { id: string; label: string; title: string; rows: PreviewRow[]; footer: string; }

const tabs: PreviewTab[] = [
  {
    id: "pos",
    label: "POS",
    title: "Counter order entry",
    rows: [
      { name: "Table 4 — Margherita Pizza x2", meta: "Dine-in" },
      { name: "Table 4 — Iced Tea x2", meta: "Dine-in" },
      { name: "Takeaway #118 — Chicken Wrap", meta: "Pickup" },
    ],
    footer: "Subtotal calculated · Tax configured · Send to kitchen",
  },
  {
    id: "kds",
    label: "Kitchen Display",
    title: "Live kitchen queue",
    rows: [
      { name: "Order #118 — Chicken Wrap", meta: "New", status: "new" },
      { name: "Table 4 — Margherita Pizza x2", meta: "Preparing", status: "preparing" },
      { name: "Table 2 — Pasta Alfredo", meta: "Ready", status: "ready" },
    ],
    footer: "3 active tickets · Updated in real time",
  },
  {
    id: "status",
    label: "Customer Order Status",
    title: "Pickup counter display",
    rows: [
      { name: "#116", meta: "Ready", status: "ready" },
      { name: "#117", meta: "Preparing", status: "preparing" },
      { name: "#118", meta: "New", status: "new" },
    ],
    footer: "Browser-based display · No app required",
  },
  {
    id: "hq",
    label: "Headquarters Reporting",
    title: "Multi-outlet overview",
    rows: [
      { name: "Outlet — Indiranagar", meta: "Sales trend, order volume" },
      { name: "Outlet — Koramangala", meta: "Sales trend, order volume" },
      { name: "Outlet — Whitefield", meta: "Sales trend, order volume" },
    ],
    footer: "Illustrative preview · Figures are not live customer data",
  },
];
---
<div class="preview-tabs" data-preview-tabs>
  <div role="tablist" aria-label="Product preview" class="preview-tabs__list">
    {tabs.map((tab, i) => (
      <button
        role="tab"
        id={`tab-${tab.id}`}
        aria-controls={`panel-${tab.id}`}
        aria-selected={i === 0 ? "true" : "false"}
        tabindex={i === 0 ? 0 : -1}
        class="preview-tabs__tab"
        data-tab={tab.id}
      >
        {tab.label}
      </button>
    ))}
  </div>

  {tabs.map((tab, i) => (
    <div
      role="tabpanel"
      id={`panel-${tab.id}`}
      aria-labelledby={`tab-${tab.id}`}
      class="preview-tabs__panel"
      hidden={i !== 0}
      data-panel={tab.id}
    >
      <div class="mockup-panel">
        <p class="mockup-panel__title">{tab.title}</p>
        <ul class="mockup-panel__rows">
          {tab.rows.map((row) => (
            <li class="mockup-panel__row">
              <span class="mockup-panel__row-name">{row.name}</span>
              {row.status ? (
                <span class={`status-pill status-pill--${row.status}`}>{row.meta}</span>
              ) : (
                <span class="mockup-panel__meta">{row.meta}</span>
              )}
            </li>
          ))}
        </ul>
        <p class="mockup-panel__footer">{tab.footer}</p>
      </div>
    </div>
  ))}
</div>

<style>
  .preview-tabs__list { display: flex; flex-wrap: wrap; gap: var(--space-2); margin-bottom: var(--space-5); }
  .preview-tabs__tab {
    background: var(--color-surface); color: var(--color-text-secondary); border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-pill); padding: var(--space-2) var(--space-4); font: inherit; font-size: 0.82rem; font-weight: 600; cursor: pointer;
    transition: background-color 0.15s ease, color 0.15s ease, border-color 0.15s ease;
  }
  .preview-tabs__tab:hover { border-color: var(--color-brand); color: var(--color-brand-hover); }
  .preview-tabs__tab[aria-selected="true"] { background: var(--color-brand); color: #fff; border-color: var(--color-brand); }
  .preview-tabs__panel .mockup-panel { max-width: 460px; }
</style>

<script>
  const roots = document.querySelectorAll<HTMLElement>("[data-preview-tabs]");
  roots.forEach((root) => {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
    const panels = Array.from(root.querySelectorAll<HTMLElement>('[role="tabpanel"]'));

    function activate(tab: HTMLButtonElement) {
      tabs.forEach((t) => {
        const selected = t === tab;
        t.setAttribute("aria-selected", String(selected));
        t.tabIndex = selected ? 0 : -1;
      });
      panels.forEach((p) => {
        p.hidden = p.dataset.panel !== tab.dataset.tab;
      });
      tab.focus();
    }

    tabs.forEach((tab, i) => {
      tab.addEventListener("click", () => activate(tab));
      tab.addEventListener("keydown", (e) => {
        if (e.key === "ArrowRight") activate(tabs[(i + 1) % tabs.length]);
        if (e.key === "ArrowLeft") activate(tabs[(i - 1 + tabs.length) % tabs.length]);
        if (e.key === "Home") activate(tabs[0]);
        if (e.key === "End") activate(tabs[tabs.length - 1]);
      });
    });
  });
</script>
