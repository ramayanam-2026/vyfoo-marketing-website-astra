---
/**
 * A single, composed "operations snapshot" for the hero — not a tabbed
 * interface (that's ProductPreviewTabs, used later in its own section).
 * Deliberately shows one coherent moment across POS, kitchen, and
 * reporting rather than every feature at once.
 */
---
<div class="hero-visual" aria-hidden="true">
  <div class="hero-visual__card mockup-panel">
    <p class="mockup-panel__title">
      Counter — Order #118
      <span class="hero-visual__clock">2:41 PM</span>
    </p>
    <ul class="mockup-panel__rows">
      <li class="mockup-panel__row">
        <span class="mockup-panel__row-name">Margherita Pizza × 2</span>
        <span class="mockup-panel__meta">Table 04</span>
      </li>
      <li class="mockup-panel__row">
        <span class="mockup-panel__row-name">Chicken Wrap</span>
        <span class="mockup-panel__meta">Takeaway</span>
      </li>
      <li class="mockup-panel__row">
        <span class="mockup-panel__row-name">Iced Tea × 2</span>
        <span class="mockup-panel__meta">Table 04</span>
      </li>
    </ul>

    <div class="hero-visual__divider"></div>

    <p class="mockup-panel__title">Kitchen</p>
    <div class="hero-visual__kitchen">
      <div class="hero-visual__chip">
        <span>#116</span>
        <span class="status-pill status-pill--ready">Ready</span>
      </div>
      <div class="hero-visual__chip">
        <span>#117</span>
        <span class="status-pill status-pill--preparing">Preparing</span>
      </div>
      <div class="hero-visual__chip">
        <span>#118</span>
        <span class="status-pill status-pill--new">New</span>
      </div>
    </div>

    <div class="hero-visual__divider"></div>

    <div class="hero-visual__stats">
      <div>
        <p class="hero-visual__stat-label">Today's orders</p>
        <p class="hero-visual__stat-value">312</p>
      </div>
      <div>
        <p class="hero-visual__stat-label">Avg. prep time</p>
        <p class="hero-visual__stat-value">6m 40s</p>
      </div>
      <div>
        <p class="hero-visual__stat-label">Outlets live</p>
        <p class="hero-visual__stat-value">3</p>
      </div>
    </div>

    <p class="mockup-panel__footer">Illustrative product preview — not live customer data.</p>
  </div>

  <div class="hero-visual__floating">
    <span class="status-pill status-pill--ready">Order ready</span>
    <p>Table 04 notified automatically</p>
  </div>
</div>

<style>
  .hero-visual { position: relative; }
  .hero-visual__card { max-width: 420px; margin-inline: auto; }
  .hero-visual__clock { font-weight: 400; text-transform: none; letter-spacing: 0; color: var(--color-text-tertiary); }
  .hero-visual__divider { height: 1px; background: var(--color-border); margin-block: var(--space-4); }
  .hero-visual__kitchen { display: flex; flex-direction: column; gap: var(--space-2); margin-bottom: var(--space-2); }
  .hero-visual__chip {
    display: flex; justify-content: space-between; align-items: center; gap: var(--space-3);
    padding: var(--space-2) var(--space-3); background: var(--color-surface-subtle); border-radius: var(--radius-sm);
    font-size: 0.85rem; font-weight: 500;
  }
  .hero-visual__stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-3); margin-bottom: var(--space-4); }
  .hero-visual__stat-label { font-size: 0.7rem; color: var(--color-text-secondary); margin: 0 0 var(--space-1); }
  .hero-visual__stat-value { font-family: var(--font-display); font-size: 1.3rem; color: var(--color-text-primary); margin: 0; }

  .hero-visual__floating {
    position: absolute; bottom: -18px; left: -8px;
    background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-md);
    box-shadow: var(--shadow-md); padding: var(--space-3) var(--space-4);
    display: flex; align-items: center; gap: var(--space-3); max-width: 260px;
  }
  .hero-visual__floating p { margin: 0; font-size: 0.78rem; color: var(--color-text-secondary); }

  @media (max-width: 640px) {
    .hero-visual__floating { display: none; }
  }
</style>
