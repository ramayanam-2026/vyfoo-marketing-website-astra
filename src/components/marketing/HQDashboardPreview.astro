---
/** Illustrative multi-outlet HQ view. Sample data only. */
const outlets = [
  { name: "Downtown", orders: "482", level: 88, badge: "Synced", tone: "emerald" },
  { name: "Airport", orders: "391", level: 70, badge: "Synced", tone: "emerald" },
  { name: "Riverside", orders: "263", level: 48, badge: "Local mode", tone: "sky" },
  { name: "Harbour", orders: "340", level: 62, badge: "Synced", tone: "emerald" },
];
---
<div class="window hq" role="img" aria-label="Illustrative headquarters dashboard comparing four outlets by orders and sync status">
  <div class="window__chrome">
    <div class="window__dots" aria-hidden="true"><i></i><i></i><i></i></div>
    <p class="window__status"><span class="pulse-dot"></span><span>HQ ledger</span><span class="sep">•</span><span>4 outlets</span></p>
  </div>
  <div class="window__body">
    <div class="kpis">
      <div><span class="mock-label">Orders today</span><strong>1,476</strong></div>
      <div><span class="mock-label">Avg ticket time</span><strong>06:12</strong></div>
      <div class="kpis__hide"><span class="mock-label">Outlets live</span><strong>4 / 4</strong></div>
    </div>
    <ul class="rows">
      {outlets.map((o) => (
        <li>
          <div class="rows__head">
            <span class="rows__name">{o.name}</span>
            <span class="rows__orders">{o.orders} orders</span>
            <span class={`badge badge--${o.tone}`}>{o.badge}</span>
          </div>
          <div class="rows__bar"><i style={`width:${o.level}%`}></i></div>
        </li>
      ))}
    </ul>
  </div>
  <p class="window__note">Illustrative preview · sample data, not real customer results</p>
</div>

<style>
  .hq { width: 100%; max-width: 560px; min-width: 0; }
  .kpis { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px; margin-bottom: 12px; }
  .kpis div { display: flex; flex-direction: column; gap: 6px; padding: 12px; border-radius: 12px; background: var(--color-obsidian-elevated); border: 1px solid var(--color-border-dark); }
  .kpis .mock-label { font-size: 0.6rem; }
  .kpis strong { font-family: var(--font-display); font-size: 1.35rem; font-weight: 700; letter-spacing: -0.02em; line-height: 1; color: #fff; }
  .rows { list-style: none; margin: 0; padding: 14px; display: flex; flex-direction: column; gap: 14px; border-radius: 12px; background: var(--color-obsidian-elevated); border: 1px solid var(--color-border-dark); }
  .rows__head { display: flex; align-items: center; gap: 10px; margin-bottom: 8px; font-size: 0.86rem; }
  .rows__name { font-weight: 600; color: #fff; }
  .rows__orders { margin-right: auto; font-family: var(--font-mono); font-size: 0.72rem; color: var(--color-text-on-dark-muted); }
  .rows__bar { height: 6px; border-radius: 9999px; background: rgba(255, 255, 255, 0.07); overflow: hidden; }
  .rows__bar i { display: block; height: 100%; border-radius: 9999px; background: linear-gradient(90deg, #be123c, #fb7185); }
  @media (max-width: 420px) {
    .kpis { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .kpis__hide { display: none !important; }
    .rows__orders { display: none; }
    .rows__name { margin-right: auto; }
  }
</style>
