---
import { CONTACT_EMAIL } from "../../lib/urls";
---
<form class="lead-form" data-lead-form novalidate>
  <div class="lead-form__row">
    <div class="lead-form__field">
      <label for="lf-name">Full name <span aria-hidden="true">*</span></label>
      <input id="lf-name" name="fullName" type="text" required aria-required="true" autocomplete="name" />
    </div>
    <div class="lead-form__field">
      <label for="lf-email">Work email <span aria-hidden="true">*</span></label>
      <input id="lf-email" name="workEmail" type="email" required aria-required="true" autocomplete="email" />
    </div>
  </div>
  <div class="lead-form__row">
    <div class="lead-form__field">
      <label for="lf-company">Company <span aria-hidden="true">*</span></label>
      <input id="lf-company" name="company" type="text" required aria-required="true" autocomplete="organization" />
    </div>
    <div class="lead-form__field">
      <label for="lf-role">Role</label>
      <input id="lf-role" name="role" type="text" autocomplete="organization-title" />
    </div>
  </div>
  <div class="lead-form__row">
    <div class="lead-form__field">
      <label for="lf-country">Country</label>
      <input id="lf-country" name="country" type="text" autocomplete="country-name" />
    </div>
    <div class="lead-form__field">
      <label for="lf-outlets">Number of outlets</label>
      <select id="lf-outlets" name="outletCount">
        <option value="">Select a range</option>
        <option value="1">1 (single outlet)</option>
        <option value="2-5">2–5</option>
        <option value="6-20">6–20</option>
        <option value="21-50">21–50</option>
        <option value="50+">50+</option>
      </select>
    </div>
  </div>
  <div class="lead-form__row">
    <div class="lead-form__field">
      <label for="lf-model">Restaurant operating model</label>
      <select id="lf-model" name="operatingModel">
        <option value="">Select the closest fit</option>
        <option>Independent restaurant / café</option>
        <option>QSR chain</option>
        <option>Cloud kitchen</option>
        <option>Fine dining</option>
        <option>Multi-outlet / franchise group</option>
        <option>Hotel F&B</option>
        <option>Other</option>
      </select>
    </div>
    <div class="lead-form__field">
      <label for="lf-current">Current POS or restaurant management system</label>
      <input id="lf-current" name="currentSystem" type="text" />
    </div>
  </div>
  <div class="lead-form__field lead-form__field--full">
    <label for="lf-challenge">Primary operational challenge</label>
    <textarea id="lf-challenge" name="primaryChallenge" rows="3"></textarea>
  </div>
  <div class="lead-form__field lead-form__field--full">
    <label for="lf-timeline">Implementation timeline (optional)</label>
    <input id="lf-timeline" name="implementationTimeline" type="text" placeholder="e.g. next quarter, exploring options" />
  </div>

  <p class="lead-form__privacy">
    By submitting this form you agree to be contacted about Vyfoo, per
    <a href="/privacy">our privacy policy</a>. We don't sell your information.
  </p>

  <button type="submit" class="btn btn--primary btn--lg btn--block" data-lead-form-submit>Request Enterprise Demo</button>

  <div class="lead-form__status" role="status" aria-live="polite" data-lead-form-status hidden></div>
</form>

<style>
  .lead-form { max-width: 100%; }
  .lead-form__row { display: grid; gap: var(--space-4); grid-template-columns: 1fr; margin-bottom: var(--space-4); }
  @media (min-width: 560px) { .lead-form__row { grid-template-columns: 1fr 1fr; } }
  .lead-form__field--full { margin-bottom: var(--space-4); }
  .lead-form__field label { display: block; font-weight: 600; font-size: 0.86rem; margin-bottom: var(--space-2); color: var(--color-text-primary); }
  .lead-form__field label span { color: var(--color-brand); }
  .lead-form__field input, .lead-form__field select, .lead-form__field textarea {
    width: 100%; padding: var(--space-3); border: 1px solid var(--color-border-strong); border-radius: var(--radius-sm);
    font: inherit; font-size: 0.95rem; background: var(--color-surface); color: var(--color-text-primary);
    min-height: 46px; transition: border-color 0.15s ease;
  }
  .lead-form__field input:hover, .lead-form__field select:hover, .lead-form__field textarea:hover { border-color: var(--color-text-secondary); }
  .lead-form__field textarea { min-height: auto; resize: vertical; }
  .lead-form__privacy { font-size: 0.8rem; color: var(--color-text-secondary); margin-bottom: var(--space-5); }
  .lead-form__status { margin-top: var(--space-4); padding: var(--space-4); border-radius: var(--radius-sm); font-size: 0.9rem; }
  .lead-form__status[data-state="success"] { background: var(--color-success-soft); color: var(--color-success); }
  .lead-form__status[data-state="error"] { background: var(--color-brand-soft); color: var(--color-brand-hover); }
</style>

<script define:vars={{ contactEmail: CONTACT_EMAIL }}>
  const form = document.querySelector("[data-lead-form]");
  const status = document.querySelector("[data-lead-form-status]");
  const submitBtn = document.querySelector("[data-lead-form-submit]");
  const endpoint = import.meta.env.PUBLIC_VYFOO_LEADS_ENDPOINT;

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    const data = Object.fromEntries(new FormData(form));

    if (!data.fullName || !data.workEmail || !data.company) {
      status.hidden = false;
      status.dataset.state = "error";
      status.textContent = "Please fill in your name, work email, and company.";
      return;
    }

    if (!endpoint) {
      status.hidden = false;
      status.dataset.state = "error";
      status.innerHTML =
        `This form isn't connected to our CRM yet, so it can't be submitted automatically. ` +
        `Please email ${contactEmail} with your details instead and our team will follow up directly.`;
      return;
    }

    submitBtn.disabled = true;
    submitBtn.textContent = "Submitting…";

    try {
      const res = await fetch(endpoint, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ ...data, source: "enterprise-demo-form" }),
      });
      if (!res.ok) throw new Error("submission failed");
      status.hidden = false;
      status.dataset.state = "success";
      status.textContent = "Thanks — your request was received. Our enterprise team will reach out shortly.";
      form.reset();
    } catch {
      status.hidden = false;
      status.dataset.state = "error";
      status.innerHTML =
        `Something went wrong submitting this form. Please email ${contactEmail} directly so we don't lose your request.`;
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = "Request Enterprise Demo";
    }
  });
</script>
