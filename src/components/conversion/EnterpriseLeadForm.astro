---
import { CONTACT_EMAIL } from "../../lib/urls";

interface Props {
  /** "demo" (Book Enterprise Demo) or "enterprise" (Talk to Enterprise Sales); sent to the webhook as formType. */
  formType?: "demo" | "enterprise";
  formName?: string;
}
const { formType = "demo", formName = "Book Enterprise Demo" } = Astro.props;
---
<form class="lead-form" data-lead-form data-form-type={formType} data-form-name={formName} data-email={CONTACT_EMAIL} novalidate>
  <div class="lead-form__row">
    <div class="lead-form__field">
      <label for="lf-name">Full name <span aria-hidden="true">*</span></label>
      <input id="lf-name" name="fullName" type="text" required aria-required="true" autocomplete="name" aria-describedby="lf-name-error" data-error="Please enter your full name." />
      <p class="lead-form__error" id="lf-name-error" hidden></p>
    </div>
    <div class="lead-form__field">
      <label for="lf-email">Work email <span aria-hidden="true">*</span></label>
      <input id="lf-email" name="workEmail" type="email" required aria-required="true" autocomplete="email" aria-describedby="lf-email-error" data-error="Please enter your work email." />
      <p class="lead-form__error" id="lf-email-error" hidden></p>
    </div>
  </div>
  <div class="lead-form__row">
    <div class="lead-form__field">
      <label for="lf-company">Company <span aria-hidden="true">*</span></label>
      <input id="lf-company" name="company" type="text" required aria-required="true" autocomplete="organization" aria-describedby="lf-company-error" data-error="Please enter your company name." />
      <p class="lead-form__error" id="lf-company-error" hidden></p>
    </div>
    <div class="lead-form__field">
      <label for="lf-role">Role</label>
      <input id="lf-role" name="role" type="text" autocomplete="organization-title" />
    </div>
  </div>
  <div class="lead-form__row">
    <div class="lead-form__field">
      <label for="lf-country">Country</label>
      <input id="lf-country" name="country" type="text" autocomplete="country-name" />
    </div>
    <div class="lead-form__field">
      <label for="lf-outlets">Number of outlets</label>
      <select id="lf-outlets" name="outletCount">
        <option value="">Select a range</option>
        <option value="1">1 (single outlet)</option>
        <option value="2-5">2–5</option>
        <option value="6-20">6–20</option>
        <option value="21-50">21–50</option>
        <option value="50+">50+</option>
      </select>
    </div>
  </div>
  <div class="lead-form__row">
    <div class="lead-form__field">
      <label for="lf-model">Restaurant operating model</label>
      <select id="lf-model" name="operatingModel">
        <option value="">Select the closest fit</option>
        <option>Independent restaurant / café</option>
        <option>QSR chain</option>
        <option>Cloud kitchen</option>
        <option>Fine dining</option>
        <option>Multi-outlet / franchise group</option>
        <option>Hotel F&amp;B</option>
        <option>Other</option>
      </select>
    </div>
    <div class="lead-form__field">
      <label for="lf-current">Current POS or management system</label>
      <input id="lf-current" name="currentSystem" type="text" />
    </div>
  </div>
  <div class="lead-form__field lead-form__field--full">
    <label for="lf-challenge">Primary operational challenge</label>
    <textarea id="lf-challenge" name="primaryChallenge" rows="3"></textarea>
  </div>
  <div class="lead-form__field lead-form__field--full">
    <label for="lf-timeline">Implementation timeline (optional)</label>
    <input id="lf-timeline" name="implementationTimeline" type="text" placeholder="e.g. next quarter, exploring options" />
  </div>

  <div class="lead-form__hp" aria-hidden="true">
    <label for="lf-hp">Leave this field empty</label>
    <input id="lf-hp" name="hp_field" type="text" tabindex="-1" autocomplete="off" />
  </div>

  <p class="lead-form__privacy">
    By submitting this form you agree to be contacted about Vyfoo, per
    <a href="/privacy">our privacy policy</a>. We don't sell your information.
  </p>

  <button type="submit" class="btn btn--primary btn--block" data-lead-form-submit>Request Enterprise Demo</button>

  <div class="lead-form__status" role="status" aria-live="polite" data-lead-form-status hidden></div>
</form>

<script>
  import { initLeadForm } from "../../lib/forms";
  document.querySelectorAll<HTMLFormElement>("[data-lead-form]").forEach(initLeadForm);
</script>
