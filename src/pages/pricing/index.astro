---
import MarketingLayout from "../../layouts/MarketingLayout.astro";
import { pricingTiers, starterOfferTerms } from "../../data/pricing";
import { urls } from "../../lib/urls";
---
<MarketingLayout
  title="Pricing"
  description="Vyfoo pricing: $99/month for independent restaurants (Vyfoo Complete), custom per-location pricing for growing chains, and enterprise plans for franchises and large groups."
  path="/pricing"
>
  <section class="page-hero pricing-intro">
    <div class="container">
      <p class="breadcrumbs"><a href="/">Home</a> / Pricing</p>
      <h1>Pricing for independent restaurants and growing chains.</h1>
      <p>Start with a single outlet, or speak with our team about a multi-location rollout.</p>
    </div>
  </section>

  <section class="section-tight" id="start-trial">
    <div class="container">
      <div class="pricing-grid">
        {pricingTiers.map((tier) => (
          <div class={`pricing-card card ${tier.featured ? "pricing-card--featured" : ""}`}>
            {tier.featured && <span class="pricing-card__ribbon">For growing groups</span>}
            <h2>{tier.name}</h2>
            <p class="pricing-card__buyer">{tier.buyer}</p>
            <p class="pricing-card__price">
              {tier.price}
              <span class="pricing-card__price-note">{tier.priceNote ?? " "}</span>
            </p>
            <p class="pricing-card__positioning">{tier.positioning}</p>
            <a class={`btn btn--block ${tier.featured ? "btn--primary" : "btn--ghost"}`} href={tier.ctaHref}>{tier.ctaLabel}</a>
            <div class="pricing-card__divider"></div>
            <ul class="pricing-card__list">{tier.included.map((i) => <li>{i}</li>)}</ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--cream">
    <div class="container">
      <h2>Starter plan terms</h2>
      <ul class="check-list">
        {starterOfferTerms.map((t) => <li>{t}</li>)}
      </ul>
      <p class="caveat-note">A free trial and a money-back guarantee are different things — see above for what applies to each.</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2>Compare plans</h2>
      <div class="table-wrap">
        <table class="compare-table">
          <thead><tr><th>Capability</th><th>Starter</th><th>Growth</th><th>Enterprise</th></tr></thead>
          <tbody>
            <tr><td>POS, KDS, QR ordering, OSDS</td><td><span class="tick" role="img" aria-label="Included"></span></td><td><span class="tick" role="img" aria-label="Included"></span></td><td><span class="tick" role="img" aria-label="Included"></span></td></tr>
            <tr><td>Inventory, CRM, Reporting</td><td><span class="tick" role="img" aria-label="Included"></span></td><td><span class="tick" role="img" aria-label="Included"></span></td><td><span class="tick" role="img" aria-label="Included"></span></td></tr>
            <tr><td>Outlets</td><td>1</td><td>Multiple</td><td>Multiple / franchise</td></tr>
            <tr><td>Cross-outlet reporting</td><td><span aria-label="Not included">—</span></td><td><span class="tick" role="img" aria-label="Included"></span></td><td><span class="tick" role="img" aria-label="Included"></span></td></tr>
            <tr><td>Rollout & migration planning</td><td><span aria-label="Not included">—</span></td><td>Available</td><td><span class="tick" role="img" aria-label="Included"></span></td></tr>
            <tr><td>Integration scoping</td><td><span aria-label="Not included">—</span></td><td>Available</td><td><span class="tick" role="img" aria-label="Included"></span></td></tr>
            <tr><td>Commercial terms</td><td>Published</td><td>Custom</td><td>Custom</td></tr>
          </tbody>
        </table>
      </div>
      <p class="caveat-note">Enterprise capabilities, SLAs, and commercial terms are confirmed during scoping — they aren't automatically included.</p>
    </div>
  </section>

  <section class="section section--cream">
    <div class="container">
      <h2>Pricing FAQ</h2>
      <div class="pricing-faq">
        <div class="card"><h3>Is a credit card required for the trial?</h3><p>No — the Starter plan trial does not require a credit card to begin.</p></div>
        <div class="card"><h3>Can I switch plans later?</h3><p>Yes — as your outlet count grows, talk to our team about moving from Starter to Growth or Enterprise.</p></div>
        <div class="card"><h3>What determines Growth/Enterprise pricing?</h3><p>Per-location and enterprise pricing depends on outlet count, rollout scope, and integration requirements, confirmed during scoping.</p></div>
        <div class="card"><h3>Is support included?</h3><p>Setup and training are part of the Starter offer as outlined at signup — confirm current support terms with our team.</p></div>
      </div>
    </div>
  </section>

  <section class="section section--ink">
    <div class="container cta-split">
      <div><h2>Not sure which plan fits?</h2><p>Talk to our team about your outlet count and operating model.</p></div>
      <a class="btn btn--on-ink btn--lg" href={urls.contact}>Talk to us</a>
    </div>
  </section>
</MarketingLayout>

<style>
  .pricing-intro { padding-bottom: var(--space-8); }
  .pricing-grid { display: grid; gap: var(--space-6); grid-template-columns: 1fr; align-items: stretch; }
  @media (min-width: 860px) { .pricing-grid { grid-template-columns: repeat(3, 1fr); } }

  .pricing-card { position: relative; display: flex; flex-direction: column; padding: var(--space-8); }
  .pricing-card h2 { font-size: 1.25rem; letter-spacing: -0.02em; margin-bottom: var(--space-2); }
  .pricing-card--featured { border-color: var(--color-text-primary); box-shadow: var(--shadow-lg); }
  .pricing-card__ribbon {
    position: absolute; top: -13px; left: var(--space-8);
    background: var(--color-brand); color: #fff; box-shadow: var(--brand-glow);
    font-family: var(--font-mono); font-size: 0.66rem; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase;
    padding: 6px 12px; border-radius: var(--radius-pill);
  }
  .pricing-card__buyer { margin: 0 0 var(--space-5); max-width: none; font-size: 0.85rem; font-weight: 600; color: var(--color-text-tertiary); }
  .pricing-card__price { margin: 0 0 var(--space-3); max-width: none; font-family: var(--font-display); font-weight: 800; font-size: 2.75rem; line-height: 1.05; letter-spacing: -0.035em; color: var(--color-text-primary); }
  .pricing-card__price-note { display: block; min-height: 2.9em; margin-top: 6px; line-height: 1.45; font-family: var(--font-body); font-weight: 500; font-size: 0.85rem; letter-spacing: 0; color: var(--color-text-tertiary); }
  .pricing-card__positioning { font-size: 0.95rem; margin-bottom: var(--space-6); }
  .pricing-card__divider { height: 1px; background: var(--color-border); margin-block: var(--space-6) var(--space-5); }
  .pricing-card__list { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: var(--space-3); font-size: 0.92rem; color: var(--color-text-secondary); }
  .pricing-card__list li { position: relative; padding-left: 1.7rem; }
  .pricing-card__list li::before { content: ""; position: absolute; left: 0; top: 0.2em; width: 18px; height: 18px; border-radius: 50%; background: var(--color-emerald-bg); }
  .pricing-card__list li::after { content: ""; position: absolute; left: 4px; top: calc(0.2em + 4px); width: 10px; height: 10px; background: var(--color-emerald-text); -webkit-mask: var(--icon-check) center / contain no-repeat; mask: var(--icon-check) center / contain no-repeat; }

  /* Align every row (name, buyer, price, copy, button, list) across the three cards */
  @supports (grid-template-rows: subgrid) {
    @media (min-width: 860px) {
      .pricing-card { display: grid; grid-row: span 7; grid-template-rows: subgrid; row-gap: 0; }
    }
  }
  @supports not (grid-template-rows: subgrid) { .pricing-card__positioning { min-height: 4.5em; } }

  .pricing-faq { display: grid; gap: var(--space-5); grid-template-columns: 1fr; }
  @media (min-width: 720px) { .pricing-faq { grid-template-columns: 1fr 1fr; } }
</style>
