---
import MarketingLayout from "../layouts/MarketingLayout.astro";
import HeroProductVisual from "../components/marketing/HeroProductVisual.astro";
import ProductPreviewTabs from "../components/marketing/ProductPreviewTabs.astro";
import HQDashboardPreview from "../components/marketing/HQDashboardPreview.astro";
import FaqAccordion from "../components/marketing/FaqAccordion.astro";
import { urls } from "../lib/urls";
import { productModules } from "../data/products";
import { solutions } from "../data/solutions";
import { pricingTiers } from "../data/pricing";
import { homepageFaqs } from "../data/faqs";
import { softwareApplicationJsonLd } from "../lib/seo";

const enterpriseSolutions = solutions.filter((s) => s.category === "enterprise");
const specializedSolutions = solutions.filter((s) => s.category === "specialized");
---
<MarketingLayout
  title="Vyfoo — The Restaurant Operating System for Independent Restaurants and Growing Chains"
  description="Connect POS billing, kitchen operations, QR ordering, customer fulfillment, inventory, and reporting in one restaurant operating system. For independent restaurants and multi-outlet groups."
  path="/"
  structuredData={[softwareApplicationJsonLd()]}
>
  <!-- SECTION 1: HERO -->
  <section class="hero">
    <div class="container hero__grid">
      <div class="hero__copy">
        <p class="eyebrow">One connected system. Every restaurant workflow.</p>
        <h1>Run your restaurant.<br />Not five different systems.</h1>
        <p class="hero__lede">
          Connect counter billing, kitchen operations, QR ordering, inventory, and outlet-level reporting in one
          restaurant operating system — built for independent restaurants, growing brands, and multi-outlet
          operators.
        </p>
        <div class="hero__ctas">
          <a class="btn btn--primary btn--lg" href={urls.bookDemo}>Book Enterprise Demo</a>
          <a class="btn btn--ghost btn--lg" href={urls.startTrial}>Start Free Trial</a>
        </div>
        <p class="hero__microcopy">For independent restaurants, growing brands, and multi-outlet operators. No credit card required to start a trial.</p>
      </div>
      <HeroProductVisual />
    </div>
  </section>

  <!-- SECTION 2: CORE CAPABILITIES STRIP -->
  <section class="capability-strip">
    <div class="container capability-strip__grid">
      {productModules.slice(0, 5).map((p) => (
        <a href={`/features/${p.slug}`} class="capability-strip__item">
          <span class="capability-strip__name">{p.shortName}</span>
        </a>
      ))}
    </div>
  </section>

  <!-- SECTION 3: ONE CONNECTED WORKFLOW -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">One connected journey</p>
        <h2>The same order flows through the entire restaurant operation.</h2>
      </div>
      <ol class="flow-diagram">
        <li><span class="flow-diagram__step">1</span><strong>Order captured</strong><span>Counter POS, QR ordering, takeaway</span></li>
        <li><span class="flow-diagram__step">2</span><strong>Kitchen receives it</strong><span>Digital kitchen tickets, live status</span></li>
        <li><span class="flow-diagram__step">3</span><strong>Staff update status</strong><span>Preparing → ready, tracked in real time</span></li>
        <li><span class="flow-diagram__step">4</span><strong>Customer fulfillment</strong><span>Pickup display, order-ready status where configured</span></li>
        <li><span class="flow-diagram__step">5</span><strong>Sales & inventory sync</strong><span>Billing, tax, recipe-based stock deduction</span></li>
        <li><span class="flow-diagram__step">6</span><strong>Management reporting</strong><span>Sales, outlet comparison, governance</span></li>
      </ol>
    </div>
  </section>

  <!-- SECTION 4: PRODUCT EXPERIENCE (tabbed showcase) -->
  <section class="section section--cream">
    <div class="container product-experience">
      <div class="section-head">
        <p class="eyebrow">Product experience</p>
        <h2>See it in action.</h2>
        <p>One system, viewed from four different seats in the restaurant.</p>
      </div>
      <ProductPreviewTabs />
    </div>
  </section>

  <!-- SECTION 5: OPERATIONAL CONTROL -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Operational control</p>
        <h2>More visibility into how the business actually runs.</h2>
      </div>
      <div class="grid-auto grid-auto--3">
        <div class="card"><h3>Order history</h3><p>See every order, and how it moved from counter to kitchen to close-out.</p></div>
        <div class="card"><h3>Role-based access</h3><p>Control who can apply discounts, process refunds, or void a transaction, where configured.</p></div>
        <div class="card"><h3>Discount & refund visibility</h3><p>Exceptions are visible to management rather than buried in till tape, where configured.</p></div>
        <div class="card"><h3>Recipe-based inventory</h3><p>Link sales to ingredient usage for a clearer stock picture, where recipes are configured.</p></div>
        <div class="card"><h3>Outlet reporting</h3><p>Compare sales and volume across locations, where multiple outlets are set up.</p></div>
        <div class="card"><h3>Cash reconciliation</h3><p>Compare expected vs. actual cash at shift close.</p></div>
      </div>
      <p class="caveat-note">These controls improve visibility and make exceptions easier to investigate. We don't claim they eliminate theft or guarantee a specific financial outcome.</p>
    </div>
  </section>

  <!-- SECTION 6: SOLUTIONS BY RESTAURANT TYPE -->
  <section class="section section--cream">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Solutions</p>
        <h2>Built around how your restaurant actually operates.</h2>
      </div>
      <h3 class="solutions-subhead">Enterprise & multi-location operations</h3>
      <div class="grid-auto grid-auto--3">
        {enterpriseSolutions.map((s) => (
          <a class="card card--link" href={`/solutions/${s.slug}`}>
            <h3>{s.name}</h3>
            <p>{s.headline}</p>
          </a>
        ))}
      </div>
      <h3 class="solutions-subhead">High-velocity & specialized restaurants</h3>
      <div class="grid-auto grid-auto--3">
        {specializedSolutions.map((s) => (
          <a class="card card--link" href={`/solutions/${s.slug}`}>
            <h3>{s.name}</h3>
            <p>{s.headline}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- SECTION 7: MULTI-OUTLET MANAGEMENT -->
  <section class="section">
    <div class="container multi-outlet">
      <div>
        <p class="eyebrow">For growing groups</p>
        <h2>Run every outlet with a clearer operating model.</h2>
        <ul class="check-list">
          <li>Cross-outlet visibility</li>
          <li>Standardized operations across locations</li>
          <li>Centralized reporting</li>
          <li>Menu and configuration governance, where supported</li>
          <li>Regional configuration for tax and operations</li>
          <li>Expansion and rollout planning</li>
        </ul>
        <a class="btn btn--primary" href={urls.bookDemo}>Book Enterprise Demo</a>
      </div>
      <HQDashboardPreview />
    </div>
  </section>

  <!-- SECTION 8: HARDWARE & INTEGRATIONS -->
  <section class="section section--cream">
    <div class="container grid-auto grid-auto--2">
      <div class="card">
        <h3>Hardware compatibility</h3>
        <p>Vyfoo is built around common restaurant hardware categories.</p>
        <ul><li>Tablets</li><li>Android POS terminals</li><li>Windows touchscreens</li><li>Browser-enabled screens</li><li>Thermal printers</li></ul>
        <a href="/hardware-compatibility">See verified compatibility →</a>
      </div>
      <div class="card">
        <h3>Integrations</h3>
        <p>We distinguish what's native today from what requires scoping.</p>
        <ul><li>CSV / Excel export</li><li>Standard receipt & KOT printing</li><li>ERP, aggregator & PMS connections — scoped per deployment</li></ul>
        <a href="/integrations">See integration details →</a>
      </div>
    </div>
  </section>

  <!-- SECTION 9: PRICING PREVIEW -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Pricing</p>
        <h2>Pricing for independent restaurants and growing chains.</h2>
      </div>
      <div class="grid-auto grid-auto--3">
        {pricingTiers.map((tier) => (
          <div class={`card pricing-card ${tier.featured ? "pricing-card--featured" : ""}`}>
            <h3>{tier.name}</h3>
            <p class="pricing-card__price">{tier.price}{tier.priceNote && <span>{" "}{tier.priceNote}</span>}</p>
            <p>{tier.positioning}</p>
            <a class="btn btn--primary btn--block" href={tier.ctaHref}>{tier.ctaLabel}</a>
          </div>
        ))}
      </div>
      <p class="section-head__cta"><a href="/pricing">See full plan comparison →</a></p>
    </div>
  </section>

  <!-- SECTION 10: FAQ -->
  <section class="section section--cream">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">FAQ</p>
        <h2>Common questions</h2>
      </div>
      <FaqAccordion faqs={homepageFaqs} />
    </div>
  </section>

  <!-- SECTION 11: FINAL CONVERSION (red brand accent, used deliberately once) -->
  <section class="section section--brand final-cta">
    <div class="container final-cta__inner">
      <h2>Make every restaurant workflow work together.</h2>
      <p>Independent restaurant? Start free. Running multiple outlets? Let's talk architecture and rollout.</p>
      <div class="final-cta__ctas">
        <a class="btn btn--on-brand btn--lg" href={urls.bookDemo}>Book Enterprise Demo</a>
        <a class="btn btn--outline-on-ink btn--lg" href={urls.startTrial}>Start Free Trial</a>
      </div>
    </div>
  </section>

  <!-- SECTION 12: Footer links + dual-conversion cards rendered by SiteFooter -->
</MarketingLayout>

<style>
  .hero { padding-block: clamp(var(--space-16), 8vw, var(--space-32)) var(--space-20); background: linear-gradient(180deg, var(--color-brand-soft) 0%, var(--color-background) 62%); }
  .hero__grid { display: grid; gap: var(--space-16); grid-template-columns: 1fr; align-items: center; }
  .hero__copy h1 { font-size: clamp(2.6rem, 2rem + 3vw, 4.4rem); }
  .hero__lede { font-size: 1.15rem; max-width: 540px; }
  .hero__ctas { display: flex; flex-wrap: wrap; gap: var(--space-4); margin-bottom: var(--space-5); }
  .hero__microcopy { font-size: 0.85rem; color: var(--color-text-secondary); max-width: 480px; }
  @media (min-width: 960px) { .hero__grid { grid-template-columns: 1.05fr 1fr; } }

  .capability-strip { border-block: 1px solid var(--color-border); background: var(--color-surface); }
  .capability-strip__grid { display: grid; grid-template-columns: repeat(2, 1fr); }
  .capability-strip__item {
    display: flex; align-items: center; justify-content: center; text-align: center;
    padding: var(--space-5) var(--space-3); text-decoration: none; color: var(--color-text-secondary);
    font-weight: 600; font-size: 0.88rem; border-right: 1px solid var(--color-border); border-bottom: 1px solid var(--color-border);
    transition: color 0.15s ease, background-color 0.15s ease;
  }
  .capability-strip__item:hover { color: var(--color-brand); background: var(--color-brand-soft); }
  @media (min-width: 640px) { .capability-strip__grid { grid-template-columns: repeat(5, 1fr); } .capability-strip__item { border-bottom: none; } }

  .section-head { max-width: var(--container-narrow); margin-bottom: var(--space-10); }
  .section-head__cta { margin-top: var(--space-8); }

  .flow-diagram { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-4); grid-template-columns: 1fr; }
  .flow-diagram li { background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-md); padding: var(--space-5); display: flex; flex-direction: column; gap: var(--space-1); }
  .flow-diagram__step { font-family: var(--font-mono); color: var(--color-brand); font-weight: 700; }
  @media (min-width: 720px) { .flow-diagram { grid-template-columns: repeat(3, 1fr); } }
  @media (min-width: 1100px) { .flow-diagram { grid-template-columns: repeat(6, 1fr); } }

  .product-experience .section-head { margin-bottom: var(--space-8); }

  .check-list { max-width: 460px; }
  .multi-outlet { display: grid; gap: var(--space-10); grid-template-columns: 1fr; align-items: center; }
  @media (min-width: 960px) { .multi-outlet { grid-template-columns: 1fr 1fr; } }

  .solutions-subhead { margin-top: var(--space-10); margin-bottom: var(--space-4); }

  .pricing-card { display: flex; flex-direction: column; gap: var(--space-3); }
  .pricing-card__price { font-family: var(--font-display); font-size: 1.8rem; color: var(--color-text-primary); }
  .pricing-card__price span { font-size: 0.88rem; color: var(--color-text-secondary); font-family: var(--font-body); }
  .pricing-card--featured { border-color: var(--color-brand); box-shadow: var(--shadow-md); }

  .final-cta__inner { max-width: 640px; }
  .final-cta__ctas { display: flex; flex-wrap: wrap; gap: var(--space-4); margin-top: var(--space-8); }
</style>
