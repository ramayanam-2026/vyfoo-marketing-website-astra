---
import MarketingLayout from "../../layouts/MarketingLayout.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
);
---
<MarketingLayout
  title="Blog"
  description="Articles on restaurant operations, kitchen display systems, offline POS architecture, inventory variance, and multi-outlet management from the Vyfoo team."
  path="/blog"
>
  <section class="page-hero">
    <div class="container">
      <p class="breadcrumbs"><a href="/">Home</a> / Blog</p>
      <h1>Blog</h1>
      <p>Practical, honest writing on restaurant operations — not SEO filler.</p>
    </div>
  </section>
  <section class="section">
    <div class="container grid-auto grid-auto--2">
      {posts.map((post) => (
        <a class="card card--link" href={`/blog/${post.id}`}>
          <span class="tag">{post.data.category}</span>
          <h3>{post.data.title}</h3>
          <p>{post.data.description}</p>
        </a>
      ))}
    </div>
  </section>
</MarketingLayout>
<style>.card--link { text-decoration: none; display: block; } .card--link:hover { border-color: var(--color-accent); }</style>
