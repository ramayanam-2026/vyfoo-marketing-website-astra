---
import MarketingLayout from "../../layouts/MarketingLayout.astro";
import { urls, CONTACT_EMAIL, CONTACT_PHONE } from "../../lib/urls";
---
<MarketingLayout
  title="Contact Vyfoo"
  description="Get in touch with Vyfoo for enterprise sales, a self-serve trial, or general questions."
  path="/contact"
>
  <section class="page-hero">
    <div class="container">
      <p class="breadcrumbs"><a href="/">Home</a> / Contact</p>
      <h1>Get in touch.</h1>
      <p>Choose the path that fits your restaurant — or reach us directly below.</p>
    </div>
  </section>

  <section class="section">
    <div class="container grid-auto grid-auto--2">
      <div class="card">
        <h2>Independent restaurant?</h2>
        <p>Start a free trial — no credit card required, no sales call needed to begin.</p>
        <a class="btn btn--primary" href={urls.startTrial}>Start Free Trial</a>
      </div>
      <div class="card">
        <h2>Multi-outlet or enterprise group?</h2>
        <p>Talk to our enterprise team about rollout, architecture, and deployment.</p>
        <a class="btn btn--primary" href={urls.bookDemo}>Book Enterprise Demo</a>
      </div>
    </div>
  </section>

  <section class="section section--cream">
    <div class="container prose">
      <h2>Reach us directly</h2>
      <p>Email: <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a></p>
      <p>Phone: <a href={`tel:${CONTACT_PHONE.replace(/\s+/g, "")}`}>{CONTACT_PHONE}</a></p>
    </div>
  </section>
</MarketingLayout>
