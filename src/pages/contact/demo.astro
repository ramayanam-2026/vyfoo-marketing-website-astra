---
import MarketingLayout from "../../layouts/MarketingLayout.astro";
import EnterpriseLeadForm from "../../components/conversion/EnterpriseLeadForm.astro";
---
<MarketingLayout
  title="Book an Enterprise Demo"
  description="Book an architecture walkthrough and enterprise demo of Vyfoo for your multi-outlet restaurant group, franchise, or chain."
  path="/contact/demo"
>
  <section class="page-hero">
    <div class="container">
      <p class="breadcrumbs"><a href="/">Home</a> / <a href="/contact">Contact</a> / Book Demo</p>
      <h1>Book an Enterprise Demo</h1>
      <p>
        Tell us a bit about your operation and we'll walk through how Vyfoo maps to your outlets, hardware, and
        rollout requirements.
      </p>
    </div>
  </section>
  <section class="section">
    <div class="container">
      <EnterpriseLeadForm />
    </div>
  </section>
</MarketingLayout>
