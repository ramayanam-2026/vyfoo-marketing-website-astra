---
import MarketingLayout from "../../layouts/MarketingLayout.astro";
import EnterpriseLeadForm from "../../components/conversion/EnterpriseLeadForm.astro";
---
<MarketingLayout
  hideFooterConvert
  title="Book an Enterprise Demo"
  description="Book an architecture walkthrough and enterprise demo of Vyfoo for your multi-outlet restaurant group, franchise, or chain."
  path="/contact/demo"
>
  <section class="section demo-page">
    <div class="container demo-page__grid">
      <div class="demo-page__intro">
        <p class="breadcrumbs"><a href="/">Home</a> / <a href="/contact">Contact</a> / Book Demo</p>
        <h1>Let's map Vyfoo to your restaurant operation.</h1>
        <p>
          Tell us a bit about your outlets and we'll walk through how Vyfoo fits your hardware, kitchen workflows,
          and reporting needs — not a generic feature tour.
        </p>
        <p class="demo-page__label">What the conversation can cover</p>
        <ul class="demo-page__list">
          <li>Number of outlets and operating model</li>
          <li>Your existing POS or restaurant management system</li>
          <li>Hardware and kitchen workflow requirements</li>
          <li>Reporting and multi-outlet visibility needs</li>
          <li>Deployment, migration, and onboarding considerations</li>
        </ul>
        <p class="caveat-note">We don't promise a fixed response time or rollout duration here — that's confirmed based on your specific scope.</p>
      </div>

      <div class="demo-page__form-card card">
        <EnterpriseLeadForm formType="demo" formName="Book Enterprise Demo" />
      </div>
    </div>
  </section>
</MarketingLayout>

<style>
  .demo-page { padding-block: clamp(var(--space-12), 6vw, var(--space-20)); }
  .demo-page__grid { display: grid; gap: var(--space-12); grid-template-columns: 1fr; align-items: start; }
  .demo-page__intro h1 { font-size: clamp(2.25rem, 3.6vw + 1rem, 3.5rem); margin-bottom: var(--space-4); }
  .demo-page__label { font-family: var(--font-mono); font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.06em; color: var(--color-text-secondary); margin: var(--space-8) 0 var(--space-3); }
  .demo-page__list { list-style: none; padding: 0; margin: 0 0 var(--space-6); display: flex; flex-direction: column; gap: var(--space-3); }
  .demo-page__list li { padding-left: 1.6em; position: relative; color: var(--color-text-secondary); font-size: 0.95rem; }
  .demo-page__list li::before { content: ""; position: absolute; left: 0; top: 0.5em; width: 8px; height: 8px; border-radius: 50%; background: var(--color-brand); }
  .demo-page__form-card { padding: var(--space-8); box-shadow: var(--shadow-lg); }
  @media (min-width: 980px) {
    .demo-page__grid { grid-template-columns: 0.9fr 1.1fr; }
    .demo-page__intro { position: sticky; top: calc(var(--nav-height) + var(--space-8)); }
  }
</style>
