---
import MarketingLayout from "../../layouts/MarketingLayout.astro";
import EnterpriseLeadForm from "../../components/conversion/EnterpriseLeadForm.astro";
---
<MarketingLayout
  title="Talk to Enterprise Sales"
  description="Talk to Vyfoo's enterprise sales team about rollout planning, architecture review, and commercial terms for your restaurant group."
  path="/contact/enterprise"
>
  <section class="page-hero">
    <div class="container">
      <p class="breadcrumbs"><a href="/">Home</a> / <a href="/contact">Contact</a> / Enterprise Sales</p>
      <h1>Talk to Enterprise Sales</h1>
      <p>For franchise operators, multi-brand groups, and chains evaluating a scoped rollout.</p>
    </div>
  </section>
  <section class="section">
    <div class="container">
      <EnterpriseLeadForm />
    </div>
  </section>
</MarketingLayout>
