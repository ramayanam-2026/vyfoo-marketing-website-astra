---
import BaseLayout from "./BaseLayout.astro";
import SiteHeader from "../components/navigation/SiteHeader.astro";
import SiteFooter from "../components/layout/SiteFooter.astro";
import type { SeoProps } from "../lib/seo";

interface Props extends SeoProps {
  structuredData?: object[];
  /** Set true to hide the dual-conversion + footer section (rarely needed). */
  hideFooterConvert?: boolean;
}

const { hideFooterConvert = false, ...props } = Astro.props;
---
<BaseLayout {...props}>
  <SiteHeader />
  <main id="main">
    <slot />
  </main>
  <SiteFooter showConvert={!hideFooterConvert} />
</BaseLayout>

<!-- Button system now lives centrally in src/styles/global.css (imported by
     BaseLayout) so every page shares one definition instead of each layout
     redefining it. -->

