# ─────────────────────────────────────────────────────────────
# Vyfoo marketing website — environment configuration
# Copy this file to .env and fill in values as they become available.
# None of these are required for the site to build and run; CTAs and
# forms fall back to honest on-site destinations/messages until
# configured. See src/lib/urls.ts and src/lib/forms.ts.
# ─────────────────────────────────────────────────────────────

# --- Public (safe to expose in the browser bundle) ---

# Base URL of the product application (outside this repo).
PUBLIC_VYFOO_APP_URL=

# Self-serve trial signup route. Until set, "Start Free Trial" CTAs
# point at the on-site pricing page instead of an invented URL.
PUBLIC_VYFOO_SIGNUP_URL=

# Existing customer login route.
PUBLIC_VYFOO_LOGIN_URL=

# Pre-populated product sandbox / demo environment.
PUBLIC_VYFOO_SANDBOX_URL=

# Webhook that receives every lead form (Book Demo, Enterprise Sales, Contact) as a
# JSON POST. Paste your webhook URL here, in your local .env and in your hosting
# provider's environment variables. Do NOT commit the real URL: this repository is
# public, and the URL works as a write-access key to your automation.
# Requirements on the receiving side: CORS must allow https://vyfoo.com (n8n: Webhook
# node > Options > Allowed Origins), and it should answer 2xx on success.
# Until set, the forms say they are not connected and offer a mailto fallback.
PUBLIC_VYFOO_LEADS_ENDPOINT=

# Google Analytics 4 Measurement ID. Optional: the production ID is the default in
# src/lib/analytics.ts. Set this only to override it (for example on staging).
# GA loads in production builds only, never under `astro dev`.
# PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# --- Server-side only (NEVER prefix with PUBLIC_) ---
# Reserved for a future serverless lead-handling endpoint, if the
# leads endpoint above is implemented as part of this repo instead of
# externally. Do not expose API secrets via PUBLIC_ variables.
# VYFOO_LEADS_API_KEY=
